  "name": "参数表助手",
  "version": "0.1.0",
  "description": "扫描 .lan 中出现的参数，检查 .pi 是否登记，一键补齐缺失行或清理未用参数。",
  "author": "生态侧",
  "main": "main.js",
  "contributes": {
    "commands": [
      { "id": "check", "title": "检查参数覆盖" },
