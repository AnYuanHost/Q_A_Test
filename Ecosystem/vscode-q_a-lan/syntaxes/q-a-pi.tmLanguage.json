{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Q_A Parameter Table",
  "scopeName": "text.q-a-pi",
  "fileTypes": ["pi"],
  "patterns": [
    { "match": "//.*$", "name": "comment.line.double-slash.q-a-pi" },
    {
      "match": "^(EmptyElement)\\s+(EmptyElement)\\s+(EmptyElement)\\s+(Unlimited)\\s+(Common)\\s*$",
      "name": "meta.parameter.empty-element.q-a-pi",
      "captures": {
        "1": { "name": "entity.name.parameter.q-a-pi" },
        "2": { "name": "support.type.q-a-pi" },
        "3": { "name": "variable.other.basis.q-a-pi" },
        "4": { "name": "constant.language.context.q-a-pi" },
        "5": { "name": "keyword.control.param-state.q-a-pi" }
      }
    },
    {
      "begin": "^(?!\\s*(//|$))",
      "end": "$",
      "name": "meta.parameter.row.q-a-pi",
      "patterns": [
        {
          "match": "^(\\S+)(?:[ \\t]+(String|UInt|SuperIndex|Bool))?(?:[ \\t]+(\\S+))?(?:[ \\t]+(Unlimited|\\S+))?(?:[ \\t]+(Login|Logout|Common|LoginOut))?[ \\t]*$",
          "captures": {
            "1": { "name": "entity.name.parameter.q-a-pi" },
            "2": { "name": "support.type.q-a-pi" },
            "3": { "name": "variable.other.basis.q-a-pi" },
            "4": { "name": "constant.language.context.q-a-pi" },
            "5": { "name": "keyword.control.param-state.q-a-pi" }
          }
        }
      ]
    }
  ]
}
