{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Q_A Solution Language",
  "scopeName": "source.q-a-lan",
  "fileTypes": ["lan"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#const-decl" },
    { "include": "#graph-block" },
    { "include": "#parallel-block" },
    { "include": "#node" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.q-a-lan"
    },
    "const-decl": {
      "match": "^\\s*(const)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(\\d+)\\s*(;)",
      "name": "meta.const.q-a-lan",
      "captures": {
        "1": { "name": "storage.type.const.q-a-lan" },
        "2": { "name": "entity.name.const.q-a-lan" },
        "3": { "name": "keyword.operator.assignment.q-a-lan" },
        "4": { "name": "constant.numeric.q-a-lan" },
        "5": { "name": "punctuation.terminator.q-a-lan" }
      }
    },
    "graph-block": {
      "match": "[{}]",
      "name": "punctuation.section.graph.q-a-lan"
    },
    "parallel-block": {
      "match": "\\[|\\]",
      "name": "punctuation.section.parallel.q-a-lan"
    },
    "node": {
      "begin": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*$",
      "beginCaptures": {
        "1": { "name": "entity.name.function.map.q-a-lan" }
      },
      "end": "^\\s*(TraUntractable|Tractable|Pending|Untractable)\\s*(?:$|//)",
      "endCaptures": {
        "1": { "name": "keyword.control.node-state.q-a-lan" }
      },
      "name": "meta.node.q-a-lan",
      "patterns": [
        { "include": "#comment" },
        { "include": "#paren-params" },
        {
          "match": "\\b(TraUntractable|Tractable|Pending|Untractable)\\b",
          "name": "keyword.control.node-state.q-a-lan"
        },
        { "include": "#identifier" }
      ]
    },
    "paren-params": {
      "match": "[()]",
      "name": "punctuation.section.parameters.q-a-lan"
    },
    "identifier": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.parameter.q-a-lan"
    }
  }
}
